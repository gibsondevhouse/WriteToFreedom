{
  "name": "write-to-freedom",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:frontend": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.legacy.json",
    "dev": "npm run build && node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "db:generate": "drizzle-kit generate",
    "schema:documents": "node scripts/document-schema.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "drizzle-orm": "^0.45.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
